{
  "name": "scamshield",
  "description": "AI Fraud Copilot for Non-Tech-Savvy Family Members",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx scripts/test-phase2.ts && tsx scripts/test-phase3.ts && tsx scripts/test-phase4.ts && tsx scripts/test-phase5.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
